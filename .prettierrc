{
    "plugins": ["prettier-plugin-blade", "@prettier/plugin-php"],
    "overrides": [
        {
            "files": ["*.blade.php"],
            "options": {
                "parser": "blade",
                "bladePhpFormatting": "safe"
            }
        }
    ],
    "singleQuote": true,
    "semi": true,
    "tabWidth": 4
}
